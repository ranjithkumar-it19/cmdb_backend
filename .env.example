# Local development: copy to backend/.env and run the API from the backend directory.
ENVIRONMENT=development
DEBUG=true
APP_NAME="Atlas Discovery & CMDB"
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-random-secret-key-before-use
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./atlas_discovery.db
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
